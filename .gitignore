# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## User settings
xcuserdata/

## compatibility with Xcode 8 and earlier (ignoring not only the settings of main project but also that of all its subprojects)
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

## compatibility with Xcode 9 and later (ignoring workspace user settings, adding scheme management to team shared workspace)
*.xcworkspace/xcshareddata/
*.xcodeproj/xcshareddata/
!*.xcworkspace/xcshareddata/WorkspaceSettings.xcsettings
!*.xcodeproj/xcshareddata/WorkspaceSettings.xcsettings

## Build generated
build/
DerivedData/

## Various settings
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.xcuserstate

## Other
*.moved-aside
*.xccheckout
*.xcscmblueprint

## App packaging
*.ipa
*.dSYM.zip
*.dSYM

## Playgrounds
timeline.xctimeline
playground.xcworkspace

